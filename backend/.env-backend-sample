FRONTEND_URL=http://localhost:3001
VONAGE_API_KEY=your_api_key
VONAGE_API_SECRET=your_api_secret

# Video API Application (for Video sessions)

VONAGE_APPLICATION_ID=your_video_app_id_here
VONAGE_PRIVATE_KEY=./video-private.key

# Voice API Application (for LVN inbound calls)

# You'll need to create a separate Voice API app in Vonage Dashboard

VONAGE_VOICE_APPLICATION_ID=your_voice_app_id_here
VONAGE_VOICE_PRIVATE_KEY=./voice-private.key

# Your Vonage Virtual Number

LVN=12089908002

# Default Video Room/Session (for simple 1:1 mapping)

DEFAULT_VIDEO_ROOM=main-conference

# Your public URL for webhooks (use ngrok for local development)

# Example: https://abc123.ngrok.io

PUBLIC_WEBHOOK_URL=https://your-ngrok-url.ngrok.io
